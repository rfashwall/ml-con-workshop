# Keep shell scripts LF-only so Windows clones don't break bash shebangs
*.sh           text eol=lf
*.bash         text eol=lf

# PowerShell stays CRLF for native Windows tooling
*.ps1          text eol=crlf

# YAML/JSON/Dockerfile: force LF for container + kube tooling
*.yaml         text eol=lf
*.yml          text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf

# Python, Go, docs: normalize to LF
*.py           text eol=lf
*.go           text eol=lf
*.md           text eol=lf
